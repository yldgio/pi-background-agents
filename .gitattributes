# Normalize line endings; the toolchain (Node type-stripping, tsc) expects LF.
* text=auto eol=lf

*.ts    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf diff=bash

# Binary assets
*.db     binary
*.png    binary
*.jpg    binary
*.gif    binary
*.webp   binary
*.mp4    binary

# Keep vendored workflow skills out of language statistics
.agents/** linguist-vendored
